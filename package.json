{
  "name": "10x-mapmaster",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite --strictPort",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest --run",
    "test:unit:coverage": "vitest --run --coverage",
    "test:e2e": "playwright test --reporter=list",
    "test:db": "npx supabase test db",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint:oxlint": "oxlint . --fix -D correctness --ignore-path .gitignore",
    "lint:eslint": "eslint . --fix",
    "lint": "run-p lint:*",
    "supabase:types": "supabase gen types --lang=typescript --local > src/types/database.ts",
    "supabase:types:remote": "supabase gen types --lang=typescript --linked > src/types/database.ts",
    "seed:all": "run-s seed:places seed:questions",
    "seed:places": "set -a && source .env.prod && set +a && npx tsx scripts/generate-places-seed.ts",
    "seed:questions": "set -a && source .env.prod && set +a && npx tsx scripts/generate-questions-seed.ts",
    "add-place": "set -a && source .env.prod && set +a && npx tsx scripts/add-new-place.ts"
  },
  "dependencies": {
    "@indoorequal/vue-maplibre-gl": "^8.4.2",
    "@popperjs/core": "^2.11.8",
    "@supabase/supabase-js": "^2.81.0",
    "@tailwindcss/vite": "^4.1.17",
    "@vee-validate/zod": "^4.15.1",
    "@vueuse/core": "^13.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "intl-messageformat": "^10.7.18",
    "lucide-vue-next": "^0.553.0",
    "maplibre-gl": "^5.12.0",
    "mitt": "^3.0.1",
    "nominatim-ts": "^0.1.4",
    "pinia": "^3.0.4",
    "reka-ui": "^2.6.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.14",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.24",
    "vue-i18n": "^11.1.12",
    "vue-router": "^4.6.3",
    "vue-sonner": "^2.0.9",
    "wikipedia": "^2.4.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@iconify-json/radix-icons": "^1.2.5",
    "@iconify/vue": "^5.0.0",
    "@playwright/test": "^1.56.1",
    "@stylistic/eslint-plugin": "^5.5.0",
    "@tsconfig/node22": "^22.0.2",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^24.10.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitest/coverage-v8": "^3.2.4",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "^9.39.1",
    "eslint-plugin-unicorn": "^61.0.2",
    "eslint-plugin-vue": "^10.5.1",
    "jiti": "^2.6.1",
    "jsdom": "^27.1.0",
    "npm-run-all2": "^8.0.4",
    "oxlint": "^1.28.0",
    "shadcn-vue": "^2.3.2",
    "supabase": "^2.54.11",
    "tsx": "^4.20.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.2",
    "vite-plugin-vue-devtools": "^8.0.3",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.1.3"
  }
}
