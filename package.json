{
  "name": "10x-mapmaster",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test": "run-s test:*",
    "test:unit": "vitest",
    "test:e2e": "playwright test --reporter=list",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint:oxlint": "oxlint . --fix -D correctness --ignore-path .gitignore",
    "lint:eslint": "eslint . --fix",
    "lint": "run-s lint:*",
    "supabase:types": "supabase gen types --lang=typescript --local > src/types/database.ts",
    "supabase:types:remote": "supabase gen types --lang=typescript --linked > src/types/database.ts",
    "generate:seed-migration": "tsx scripts/generate-seed-embeddings-hybrid.ts",
    "enrich:descriptors": "tsx scripts/enrich-and-generate-descriptors.ts",
    "generate:embeddings": "tsx scripts/generate-all-embeddings.ts"
  },
  "dependencies": {
    "@indoorequal/vue-maplibre-gl": "^8.4.2",
    "@supabase/supabase-js": "^2.75.1",
    "@tailwindcss/vite": "^4.1.14",
    "@vee-validate/zod": "^4.15.1",
    "@vueuse/core": "^13.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-vue-next": "^0.546.0",
    "maplibre-gl": "^5.9.0",
    "mitt": "^3.0.1",
    "nominatim-ts": "^0.1.4",
    "pinia": "^3.0.3",
    "reka-ui": "^2.6.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.14",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.22",
    "vue-router": "^4.6.3",
    "vue-sonner": "^2.0.9",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@iconify-json/radix-icons": "^1.2.5",
    "@iconify/vue": "^5.0.0",
    "@playwright/test": "^1.56.1",
    "@stylistic/eslint-plugin": "^5.5.0",
    "@tsconfig/node22": "^22.0.2",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^24.8.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "^9.38.0",
    "eslint-plugin-unicorn": "^61.0.2",
    "eslint-plugin-vue": "^10.5.1",
    "jiti": "^2.6.1",
    "jsdom": "^27.0.1",
    "npm-run-all2": "^8.0.4",
    "oxlint": "^1.23.0",
    "supabase": "^2.51.0",
    "tsx": "^4.20.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.1",
    "vite": "^7.1.10",
    "vite-plugin-vue-devtools": "^8.0.3",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.1.1"
  }
}
