{
  "name": "10x-mapmaster",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite --strictPort",
    "build": "run-p type-check \"build-only {@}\" --",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "test": "run-s test:unit test:e2e test:db",
    "test:all": "run-s test:unit test:e2e test:db test:security",
    "test:db": "supabase test db",
    "test:e2e": "playwright test --reporter=list",
    "test:security": "supabase test db supabase/tests/test_security.sql",
    "test:unit": "vitest --run",
    "test:unit:coverage": "vitest --run --coverage",
    "lint": "run-p lint:*",
    "lint:oxlint": "oxlint . --fix -D correctness --ignore-path .gitignore",
    "lint:eslint": "eslint . --fix",
    "format": "prettier --write .",
    "format:sql": "prettier --write \"supabase/**/*.sql\"",
    "supabase:start": "supabase start -x vector",
    "supabase:types": "supabase gen types --lang=typescript --local > src/types/database.ts",
    "db:rebuild": "bun run scripts/build-migration.ts --dev && supabase db reset && bun run supabase:types",
    "db:build-migration": "bun run scripts/build-migration.ts --prod"
  },
  "dependencies": {
    "@indoorequal/vue-maplibre-gl": "^8.4.2",
    "@popperjs/core": "^2.11.8",
    "@supabase/supabase-js": "^2.76.1",
    "@tailwindcss/vite": "^4.1.16",
    "@vee-validate/zod": "^4.15.1",
    "@vueuse/core": "^14.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "consola": "^3.4.2",
    "dotenv": "^17.2.3",
    "intl-messageformat": "^10.7.18",
    "lucide-vue-next": "^0.548.0",
    "maplibre-gl": "^5.10.0",
    "mitt": "^3.0.1",
    "nominatim-ts": "^0.1.4",
    "pinia": "^3.0.3",
    "reka-ui": "^2.6.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.14",
    "vee-validate": "^4.15.1",
    "visionscarto-world-atlas": "^1.0.0",
    "vue": "^3.5.22",
    "vue-i18n": "^11.1.12",
    "vue-router": "^4.6.3",
    "vue-sonner": "^2.0.9",
    "wikipedia": "^2.2.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@iconify-json/radix-icons": "^1.2.5",
    "@iconify/vue": "^5.0.0",
    "@playwright/test": "^1.56.1",
    "@stylistic/eslint-plugin": "^5.5.0",
    "@tsconfig/node22": "^22.0.2",
    "@types/bun": "^1.3.1",
    "@types/deno": "^2.5.0",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^24.9.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitest/coverage-v8": "^3.2.4",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-unicorn": "^61.0.2",
    "eslint-plugin-vue": "^10.5.1",
    "jiti": "^2.6.1",
    "jsdom": "^27.0.1",
    "npm-run-all2": "^8.0.4",
    "oxlint": "^1.24.0",
    "prettier": "3.6.2",
    "prettier-plugin-sql": "^0.19.2",
    "shadcn-vue": "^2.3.2",
    "supabase": "^2.53.6",
    "tsx": "^4.20.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vite": "^7.1.12",
    "vite-plugin-vue-devtools": "^8.0.3",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.1.2"
  }
}
