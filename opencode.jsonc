{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md", "openspec/AGENTS.md"],

  // Models: z.ai coding plan (main) + OpenCode Zen (fallback)
  "model": "anthropic/claude-opus-4-5",
  "small_model": "anthropic/claude-haiku-4-5",

  "keybinds": {
    "session_child_cycle": "<leader>]",
    "session_child_cycle_reverse": "<leader>[",
  },

  // Built-in agents
  "agent": {
    "build": { "disable": false },
    "plan": { "disable": false },
    "general": { "disable": true },
  },

  // MCPs - minimal useful set
  "mcp": {
    // Debugging
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest"],
    },

    // Web search + code context
    "exa": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp",
    },

    // Complex reasoning
    "sequential-thinking": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-sequential-thinking"],
    },
  },

  "permission": {
    "bash": {
      // ask by default
      "*": "ask",
      // prefer OpenCode Read, Grep, List
      "cat": "deny",
      "find": "deny",
      "ls": "deny",
      // allow
      "bun": "allow",
      "git": "allow",
      "head": "allow",
      "openspec": "allow",
      "psql": "allow",
      "supabase": "allow",
      "tail": "allow",
    },
  },

  // Global tool defaults - limit MCP exposure, enable per-agent
  "tools": {
    "chrome-devtools_*": false,
    "exa_*": true,
    "sequential-thinking_*": true,
  },
}
