{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md", "openspec/project.md"],
  "plugin": ["opencode-skills@0.1.1", "@tarquinen/opencode-dcp@0.4.2"],
  "experimental": {
    "primary_tools": ["prune"],
  },

  // Models
  "model": "anthropic/claude-opus-4-5",
  "small_model": "anthropic/claude-haiku-4-5",

  // Global defaults
  "autoupdate": "notify",
  "share": "manual",

  "keybinds": {
    "session_child_cycle": "<leader>]",
    "session_child_cycle_reverse": "<leader>[",
  },

  // Built-in agents with skill access
  "agent": {
    "build": {
      "disabled": false,
      "tools": {
        "skills_*": true,
      },
      "thinking": {
        "type": "enabled",
        "budgetTokens": 16000,
      },
    },
    "plan": {
      "disable": false,
      "thinking": {
        "type": "enabled",
        "budgetTokens": 16000,
      },
      "tools": {
        "skills_*": false,
        // Planning skills only - no execution
        "skills_using_skills": true,
        "skills_brainstorming": true,
        "skills_openspec_check": true,
        "skills_openspec_propose": true,
        "skills_task_planning": true,
        "skills_systematic_debugging": true,
        "skills_code_review": true,
        "skills_subagent_workflow": true,
        "skills_config_tuning": true,
      },
    },
    // Disable general, we use specialized agents instead
    "general": { "disable": true },
  },

  // MCPs - minimal useful set
  "mcp": {
    // Debugging
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest"],
    },

    // Web search + code context
    "exa": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp",
    },

    // Postgres
    "postgres": {
      "type": "local",
      "command": [
        "docker",
        "run",
        "-i",
        "--rm",
        "-e",
        "DATABASE_URI",
        "crystaldba/postgres-mcp",
        "--access-mode=unrestricted",
      ],
      "environment": {
        "DATABASE_URI": "postgresql://postgres:postgres@host.docker.internal:54322/postgres",
      },
    },

    // Complex reasoning
    "sequential-thinking": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-sequential-thinking"],
    },
  },

  "permission": {
    "bash": {
      // ask by default
      "*": "ask",
      // prefer OpenCode Read, Grep, List
      "find": "deny",
      "ls": "deny",
      // allow
      "bun run": "allow",
      "cat": "allow",
      "git": "allow",
      "grep": "allow",
      "head": "allow",
      "mkdir": "allow",
      "openspec": "allow",
      "psql": "allow",
      "rg": "allow",
      "supabase": "allow",
      "tail": "allow",
      "timeout": "allow",
      "wc": "allow",
    },
  },

  // Global tool defaults - limit MCP exposure, enable per-agent
  "tools": {
    "chrome-devtools_*": false,
    "exa_*": true,
    "sequential-thinking_*": true,
    "skills_*": false,
    // Custom game tools for testing/analysis
    "game_*": true,
  },
}
