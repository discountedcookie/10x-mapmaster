{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],

  // Models: z.ai coding plan (main) + OpenCode Zen (fallback)
  "model": "anthropic/claude-opus-4-5",
  "small_model": "zai-coding-plan/glm-4.6",

  "keybinds": {
    "session_child_cycle": "<leader>]",
    "session_child_cycle_reverse": "<leader>[",
  },

  // Built-in agents
  "agent": {
    "build": { "disable": false },
    "plan": { "disable": false },
    "general": { "disable": true },
  },

  // MCPs - minimal useful set
  "mcp": {
    // Web search + code context
    "exa": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp",
    },

    // Complex reasoning
    "sequential-thinking": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-sequential-thinking"],
    },
  },

  "permission": {
    "bash": {
      "*": "ask",
      "cat": "deny",
      "find": "deny",
      "grep": "deny",
      "head": "deny",
      "ls": "deny",
      "tail": "deny",
      //
      "bun *": "allow",
      "npm * ": "deny",
    },
  },

  // Global tool defaults - limit MCP exposure, enable per-agent
  "tools": {
    "exa_*": false,
    "sequential-thinking_*": false,
  },
}
