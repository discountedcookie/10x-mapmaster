{
  "$schema": "https://docs.tolgee.io/cli-schema.json",
  "projectId": 25341,
  "format": "JSON_TOLGEE",
  "patterns": ["./src/**/*.ts", "./src/**/*.vue"],
  "push": {
    "filesTemplate": "./src/i18n/locales/{languageTag}.json",
    "language": ["en", "pl"]
  },
  "pull": {
    "path": "./src/i18n/locales"
  }
}
