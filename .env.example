# Supabase Configuration
# Get these from your Supabase project dashboard
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# LLM Provider Configuration
# LLM provider: 'mistral' (production) | 'ollama' (local development)
LLM_PROVIDER=mistral
EMBEDDING_PROVIDER=mistral

# Mistral API Configuration (Production)
# Get from https://mistral.ai (free tier available)
MISTRAL_API_KEY=sk-your-mistral-api-key-here

# Ollama Configuration (Local Development)
# Embedding model configuration (1024d)
# Run: ollama pull mxbai-embed-large
OLLAMA_EMBEDDING_MODEL=mxbai-embed-large

# Legacy OpenRouter (Deprecated - use Mistral instead)
# Get from https://openrouter.ai (requires paid credits)
# Used in Supabase Edge Function: supabase/functions/generate-embedding
OPENROUTER_API_KEY=sk-or-v1-your-api-key-here

# MCP Server Configuration
# Context7 API key - Get from https://context7.ai
CONTEXT7_API_KEY=your-context7-api-key

# Supabase MCP - Your Supabase project reference ID
SUPABASE_PROJECT_REF=your-project-ref

# ConPort - Path to your context-portal installation
CONPORT_PATH=/path/to/context-portal
