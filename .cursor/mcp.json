{
    "mcpServers": {
        "context7": {
            "url": "https://mcp.context7.com/mcp"
        },
        "serena": {
            "command": "uvx",
            "args": [
                "--from",
                "git+https://github.com/oraios/serena",
                "serena",
                "start-mcp-server",
                "--context",
                "ide-assistant"
            ]
        },
        "playwright": {
            "command": "npx",
            "args": [
                "@playwright/mcp@latest"
            ]
        },
        "semgrep": {
            "type": "streamable-http",
            "url": "https://mcp.semgrep.ai/mcp"
        },
        "shadcnvue": {
            "command": "npx",
            "args": [
                "shadcn-vue@latest",
                "mcp"
            ]
        },
        "supabase": {
            "url": "https://mcp.supabase.com/mcp?project_ref=lrrcfzyjtejjbjtoaazm"
        }
    }
}